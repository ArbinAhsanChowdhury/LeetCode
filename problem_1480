#include <bits/stdc++.h>
using namespace std;
int main(){
    int arr[4] = {1,2,3,4};
    int arrsSize = size(arr);
    int SecArr[arrsSize];
    cout << arrsSize;
    int temp = 0;
    for(int i=0; i<arrsSize; i++){
        temp = temp + arr[i];
        SecArr[i] = temp;
    }
    cout << "\nthis is first array\n";
    for(int i=0; i<arrsSize; i++){
        cout << arr[i] << " ";
    }
    cout << "\nthis is second array\n";
    for(int i=0; i<arrsSize; i++){
        cout << SecArr[i] << " ";
    }
    return 0;
}
